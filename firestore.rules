/**
 * FactoryIQ Security Rules
 * 
 * Implements Authorization Independence by denormalizing membership onto documents.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(membershipMap) {
      return isSignedIn() && membershipMap != null && request.auth.uid in membershipMap;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Allow user to read/write their own profile
      allow get, write: if isOwner(userId);
      // Allow listing users if signed in (queries must be filtered by UID for privacy)
      allow list: if isSignedIn();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /programs/{programId} {
      allow get, list: if isSignedIn() && (resource == null || isMember(resource.data._members));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isMember(resource.data._members);
      allow delete: if isSignedIn() && isMember(resource.data._members);

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /alerts/{alertId} {
      allow read, update: if isSignedIn();
      allow create: if false; // System only
    }

    match /productionOrders/{orderId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Global Collections
    match /products/{id} { allow read: if isSignedIn(); }
    match /productionLines/{id} { allow read: if isSignedIn(); }
    match /suppliers/{id} { allow read: if isSignedIn(); }
    match /partComponents/{id} { allow read: if isSignedIn(); }
    match /inventoryTransactions/{id} { allow read, create: if isSignedIn(); }
    match /shipments/{id} { allow read, write: if isSignedIn(); }
    match /forecasts/{id} { allow read, write: if isSignedIn(); }
    match /customers/{id} { allow read: if isSignedIn(); }
    match /rmas/{id} { allow read, write: if isSignedIn(); }
    match /warranties/{id} { allow read: if isSignedIn(); }
    match /knowledgeBaseArticles/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /activityLogs/{id} { allow read: if isOwner(resource.data.userId); allow create: if isSignedIn(); }
    match /kpis_global/{id} { allow read: if isSignedIn(); }
  }
}